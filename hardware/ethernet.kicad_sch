	(text "RTL8211F-CG GIGABIT ETHERNET PHY\n"
		(exclude_from_sim no)
		(at 13.208 15.748 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "372e516a-a2e1-40ab-a7f2-5e2f1f23c08d")
	)
	(text "R37/R38: PHY/FPGA reference-clock source termination.\nR55/R57: optional low straps, unpopulated by default.\nL5: low-DCR PHY switching-regulator inductor.\nC89: PHY-side transformer center-tap bypass.\nC90-C93: PoE-safe Bob Smith DC-block capacitors.\nR61/R65/R66/R70: PoE-safe Bob Smith termination.\nC94: Bob Smith common node to chassis.\nJ1 footprint checked against manufacturer drawing\nand official EasyEDA C386763 geometry."
		(exclude_from_sim no)
		(at 177.038 160.528 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3ae2e1f5-deed-41e5-9f78-33d57fa73cf6")
	)
	(text "LED0/1/2 runtime nets are ETH_LED0_CFG_EXT, ETH_LED1_CFG_LDO0, ETH_LED2_CFG_LDO1; LEDs omitted, strap resistors retained."
		(exclude_from_sim no)
		(at 103.632 26.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4e01c0b8-4251-4094-a456-c92561004af3")
	)
	(text "GIGABIT ETHERNET MAGNETICS + SHIELDED 8P8C JACK"
		(exclude_from_sim no)
		(at 172.466 86.36 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "af163776-083d-4b40-ac68-fb9e93feb942")
	)
	(text "STRAPS: external 1V8; PHY address 1; PLLOFF=0; TXDLY=1 and RXDLY=1. R411/R412 are DNP low alternatives. PHY supplies both 2ns RGMII delays — host must NOT double-delay."
		(exclude_from_sim no)
		(at 103.632 21.844 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c557e3f9-628b-43ed-b8ec-56ef2c0b045d")
	)
