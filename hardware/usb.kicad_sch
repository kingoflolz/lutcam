	(text "5.1 kΩ Rd advertises a sink only; it does not negotiate or verify available source current"
		(exclude_from_sim no)
		(at 40.64 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0423164d-e5a8-4910-9075-b7777306b4d7")
	)
	(text "USB sense enabled after FPGA configuration (CDONE high).\nQ3A/Q3B are one MMDT3904 package (C41375125).\nR77 holds sense low with USB absent; C104 filters hot-plug edges.\nStartup interlock only; no precision 1V8 brownout detection."
		(exclude_from_sim no)
		(at 149.86 151.13 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left bottom)
		)
		(uuid "24eab0e1-624a-4222-8745-62209809bf10")
	)
	(text "CDONE-GATED USB VBUS SENSE"
		(exclude_from_sim no)
		(at 149.86 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "59c0d32e-f26e-43f2-a830-6fb069aab4ea")
	)
	(text "EXPLICITLY ACCEPTED\nOwner accepts these existing design tradeoffs:\n1. Non-isolated PoE; board/USB ground is not\n   galvanically isolated from PoE power.\n2. USB through D2 (SS34) can place U3/U4/U5\n   below the 4.5 V recommended VIN minimum.\n3. USB directly charges approximately 120 uF;\n   no dedicated input inrush current limiter.\nThese conditions are accepted for this revision."
		(exclude_from_sim no)
		(at 99.568 138.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d39c770a-e7f4-4874-abe6-16dac629f2f9")
	)
	(text "USB FULL-SPEED (12 Mbit/s) — direct FPGA gateware PHY"
		(exclude_from_sim no)
		(at 40.894 62.738 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ed40d36a-e389-48da-b1a5-527cfb72563b")
	)
